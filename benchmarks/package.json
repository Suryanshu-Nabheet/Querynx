{
  "name": "@querynx/benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible performance benchmarks: retrieval, extraction, merge, cache",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
