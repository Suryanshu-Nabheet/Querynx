    "@querynx/database": "workspace:*",
    "@querynx/extractor": "workspace:*",
    "@querynx/fetcher": "workspace:*",
    "@querynx/indexer": "workspace:*",
    "@querynx/observability": "workspace:*",
    "@querynx/providers": "workspace:*",
    "@querynx/queue": "workspace:*",
    "@querynx/research": "workspace:*",
    "@querynx/shared": "workspace:*",
    "@querynx/tavily-compat": "workspace:*",
    "@querynx/types": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
