{
  "name": "@querynx/api",
  "version": "0.1.0",
  "description": "Querynx HTTP API service (Fastify)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@querynx/cache": "workspace:*",
