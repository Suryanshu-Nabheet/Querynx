# Querynx API service image.
# Multi-stage build: install with dev deps, run via tsx (no build step
# keeps the image simple and the runtime identical to development).

FROM node:22-slim AS base
ENV NODE_ENV=production

# pnpm via corepack, pinned by the lockfile's packageManager field.
RUN corepack enable

WORKDIR /app

# Copy workspace manifests first for layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/types/package.json packages/types/
COPY packages/shared/package.json packages/shared/
COPY packages/fetcher/package.json packages/fetcher/
COPY packages/extractor/package.json packages/extractor/
COPY packages/providers/package.json packages/providers/
COPY packages/cache/package.json packages/cache/
COPY packages/crawler/package.json packages/crawler/
COPY packages/indexer/package.json packages/indexer/
COPY packages/research/package.json packages/research/
COPY packages/ranking/package.json packages/ranking/
COPY integrations/tavily-compatible/package.json integrations/tavily-compatible/

RUN pnpm install --frozen-lockfile --filter @querynx/api... --filter @querynx/tavily-compat...

# Application sources.
COPY tsconfig.base.json turbo.json ./
COPY packages packages
COPY integrations/tavily-compatible integrations/tavily-compatible
COPY apps/api apps/api

# Non-root runtime user with a writable cache rooted inside /app
# (the user home is not writable; corepack needs a cache location).
RUN groupadd -r querynx && useradd -r -g querynx querynx \
  && mkdir -p /app/.corepack /app/.cache \
  && chown -R querynx:querynx /app
USER querynx
ENV COREPACK_HOME=/app/.corepack XDG_CACHE_HOME=/app/.cache

# Materialize the pinned pnpm into the cache at build time so the
# runtime never needs network access or a writable home.
RUN pnpm --version

EXPOSE 3001
ENV HOST=0.0.0.0 PORT=3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:3001/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["pnpm", "--filter", "@querynx/api", "exec", "tsx", "src/server.ts"]
